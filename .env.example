# Copia este archivo como .env y completa los valores. No subas el .env real a git.

PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://usuario:clave@cluster/dispensarios
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# URL del frontend. También es el origen permitido por CORS si no defines CORS_ORIGINS.
FRONTEND_URL=https://tu-frontend.netlify.app
# Orígenes permitidos, separados por coma (ej. producción y previews).
CORS_ORIGINS=https://tu-frontend.netlify.app

# Proxies delante del backend (Railway = 1). Necesario para auditar la IP real.
TRUST_PROXY=1

# Cobros al paciente. Apagado: las notas de dispensación no tienen precio ni pago.
PAGOS_HABILITADOS=false
FLOW_SERVICE_URL=http://localhost:3800
# Secreto que Flow debe enviar en el header X-Webhook-Secret (solo si PAGOS_HABILITADOS=true).
FLOW_WEBHOOK_SECRET=

# Firma electrónica. "mock" firma solo y no tiene validez legal: cambiar al elegir proveedor.
SIGNATURE_PROVIDER=mock
# Secreto que el proveedor de firma debe enviar en el header X-Callback-Secret.
SIGNATURE_CALLBACK_SECRET=

# Protección de login: intentos fallidos antes de bloquear y minutos de bloqueo.
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Vigencia de recetas
DIAS_AVISO_RECETA=30
# Al aprobar una receta nueva, reactivar al paciente suspendido por vencimiento (true/false).
REACTIVAR_AL_RENOVAR_RECETA=true

# S3 (opcional). Si se configura, los documentos van a la carpeta documentos/ (privada, con enlaces temporales)
# y las imágenes a products/. La política del bucket debe permitir lectura pública SOLO de products/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
